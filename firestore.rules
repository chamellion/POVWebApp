rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // CLIENT-FACING COLLECTIONS
    // Public read access, authenticated write access
    // ========================================

    // Events collection - public read, authenticated write
    match /events/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Recurring Events collection - public read, authenticated write
    match /recurringEvents/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Skipped Recurring Events collection - public read, authenticated write
    match /skippedRecurringEvents/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pastors collection - public read, authenticated write
    match /pastors/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Carousel collection - public read, authenticated write
    match /carousel/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Team Leads collection - public read, authenticated write
    // ✅ This allows client app to display team leads,
    // but still restricts modifications to logged-in admins
    match /teamLeads/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ========================================
    // NEWSLETTER SIGNUP COLLECTION
    // Special rules: public create, authenticated read
    // ========================================

    match /newsletterSignups/{document} {
      allow create: if 
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$');
      
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ========================================
    // ADMIN-ONLY COLLECTIONS
    // Authenticated read/write access only
    // ========================================

    match /gallery/{document} {
      allow read, write: if request.auth != null;
    }

    // Testimonies collection - public create, authenticated read/update/delete
    match /testimonies/{document} {
      // Allow anyone to create a testimony
      allow create: if 
        // Required fields must exist and be of correct type
        request.resource.data.keys().hasAll(['testimony', 'isAnonymous']) &&
        request.resource.data.testimony is string &&
        request.resource.data.testimony.size() > 0 &&
        request.resource.data.isAnonymous is bool &&
        
        // Optional fields must be string or null if present
        (request.resource.data.name == null || (request.resource.data.name is string && request.resource.data.name.size() > 0)) &&
        (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() > 0)) &&
        
        // If anonymous, name should be null or "Anonymous"
        (request.resource.data.isAnonymous == false || (request.resource.data.name == null || request.resource.data.name == "Anonymous")) &&
        
        // Metadata auto-managed by client
        request.resource.data.createdAt is timestamp;
      
      // Only authenticated users can read testimonies
      allow read: if request.auth != null;
      
      // Only authenticated users can update/delete
      allow update, delete: if request.auth != null;
    }

    match /testimonies_exports/{document} {
      allow read, write: if request.auth != null;
    }

    match /prayerRequests/{document} {
      // Public create, authenticated read/update/delete
      allow create: if 
        request.resource.data.keys().hasAll(['request', 'isAnonymous']) &&
        request.resource.data.request is string &&
        request.resource.data.request.size() > 0 &&
        request.resource.data.isAnonymous is bool &&
        (request.resource.data.name == null || request.resource.data.name is string) &&
        (request.resource.data.email == null || request.resource.data.email is string) &&
        (request.resource.data.email == null || request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')) &&
        (request.resource.data.isAnonymous == false || (request.resource.data.name == null && request.resource.data.email == null));

      allow read, update, delete: if request.auth != null;
    }

    match /prayer_requests_exports/{document} {
      allow read, write: if request.auth != null;
    }

    // ========================================
    // CONTACT MESSAGES COLLECTION
    // Public create, authenticated read/update/delete, export supported
    // ========================================

    match /contactMessages/{document} {
      allow create: if 
        request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
        request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        // optional fields
        (request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.size() > 0)) &&
        (request.resource.data.subject == null || (request.resource.data.subject is string && request.resource.data.subject.size() > 0)) &&
        (request.resource.data.userAgent == null || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() > 0)) &&
        // preferred contact method check
        (request.resource.data.preferredContactMethod == null || request.resource.data.preferredContactMethod in ['email', 'phone', 'either']) &&
        // metadata auto-managed by client
        (request.resource.data.createdAt is timestamp) &&
        (request.resource.data.status == 'new');

      allow read, update, delete: if request.auth != null;
    }

    match /contact_messages_exports/{document} {
      allow read, write: if request.auth != null;
    }

    // ========================================
    // SITE SETTINGS COLLECTION
    // ✅ Public read (for client app), authenticated write (for admins)
    // ========================================

    match /settings/{document} {
      allow read: if true; // ✅ Anyone can read settings (social links, contact phone)
      allow write: if request.auth != null; // ✅ Only authenticated admins can write
    }

    // ========================================
    // OTHER ADMIN COLLECTIONS
    // ========================================

    match /leaders/{document} {
      allow read, write: if request.auth != null;
    }

    match /mission_vision/{document} {
      allow read, write: if request.auth != null;
    }

    match /service_times/{document} {
      allow read, write: if request.auth != null;
    }

    match /about/{document} {
      allow read, write: if request.auth != null;
    }

    match /community_service/{document} {
      allow read, write: if request.auth != null;
    }

    // ========================================
    // CONFESSION OF THE MONTH COLLECTION
    // Public read, authenticated write
    // ========================================
    
    // Confession of the Month collection - public read, authenticated write
    match /confession_of_the_month/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // ========================================
    // THEME OF THE MONTH COLLECTION
    // Public read, authenticated write
    // ========================================
    
    // Theme of the Month collection - public read, authenticated write
    match /theme_of_the_month/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // ========================================
    // ACTIVITY LOG COLLECTION
    // Immutable audit trail
    // ========================================

    match /activityLog/{document} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ========================================
    // USERS COLLECTION
    // Users can only manage their own profile
    // ========================================

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========================================
    // DEFAULT RULE
    // Deny all other access
    // ========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
